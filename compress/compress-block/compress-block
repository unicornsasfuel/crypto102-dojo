#!/usr/bin/exec-suid -- /usr/local/bin/python -I
import sys
from Crypto.Cipher import AES
from Crypto.Util.Padding import pad
from os import urandom
from gzip import compress
from binascii import hexlify

if len(sys.argv) != 2:
    sys.exit('Usage: compress-block <input_data>')

with open("/challenge/.key","rb") as key_fh:
    key = key_fh.read().strip()

with open("/flag", "rb") as f:
    flag = f.read().strip()
    cipher = AES.new(key=key, mode=AES.MODE_CBC, iv=urandom(16))
    data = compress(flag + sys.argv[1].encode('l1'))
    enc_data = cipher.encrypt(pad(data, 16))
    print(hexlify(enc_data).decode('l1'))
